# Rate Limiting Configuration
RATELIMIT_STORAGE_URI=redis://redis:6379/1
RATELIMIT_STRATEGY=moving-window
RATELIMIT_DEFAULT=200 per minute
RATELIMIT_ENABLED=true
RATELIMIT_FALLBACK_ENABLED=true
TRUSTED_PROXY_COUNT=0

# Rate Limiting Thresholds
RATELIMIT_REGISTER="5 per hour; 15 per day"
RATELIMIT_LOGIN_IP="10 per minute; 30 per hour"
RATELIMIT_LOGIN_ACCOUNT="5 per 15 minutes"
RATELIMIT_VERIFY_EMAIL="10 per 15 minutes"
RATELIMIT_RESEND_OTP="5 per hour"
RATELIMIT_FORGOT_PASSWORD="3 per hour"
RATELIMIT_RESET_PASSWORD="5 per hour"
RATELIMIT_REFRESH_TOKEN="30 per minute"
RATELIMIT_PROFILE_UPDATE="15 per minute"
RATELIMIT_DOCUMENT_UPLOAD_USER="10 per hour"
RATELIMIT_DOCUMENT_UPLOAD_IP="20 per hour"
RATELIMIT_ADMIN_ACTIONS="60 per minute"
RATELIMIT_ADMIN_QUEUE="30 per minute"
RATELIMIT_ADMIN_DOCUMENT_STREAM="30 per minute"


EMAIL_PROVIDER=console
EMAIL_SYNC_FALLBACK=true

EMAIL_FROM_ADDRESS=no-reply@creatorxdr.com
EMAIL_FROM_NAME=CreatorXDR Security
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASSWORD=smtp_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

